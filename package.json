{
  "name": "codex-pool",
  "version": "0.1.0",
  "private": true,
  "description": "Local Codex account manager with safe cold switching.",
  "type": "module",
  "bin": {
    "codex-pool": "dist/src/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "doctor": "npm run build --silent && node dist/src/cli/main.js doctor",
    "test": "npm run build --silent && node --test dist/tests/*.test.js",
    "menu:build": "mkdir -p .build && swiftc -O -parse-as-library -o .build/CodexPoolMenuBar macos/CodexPoolMenuBar.swift -framework Cocoa -framework SwiftUI",
    "menu": "npm run build --silent && npm run menu:build && .build/CodexPoolMenuBar"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
